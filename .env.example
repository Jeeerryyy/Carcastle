# ==============================================================================
# Car Castle Goa - Environment Configuration Template
# For Local Development & Vercel Production Deployment
# ==============================================================================

# Server Network Configuration
PORT=8080
NODE_ENV=production

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database & Realtime Configuration
# (From Supabase Dashboard -> Project Settings -> API)
# ------------------------------------------------------------------------------
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon Public Key (Safe for browser / client-side)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Secret Key (Optional, for backend / serverless administrative overrides)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Cloudinary Unsigned Upload Configuration (for car photo management)
# (From Cloudinary Dashboard -> Settings -> Upload -> Upload Presets)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=carcastlegoa
CLOUDINARY_UPLOAD_PRESET=carcastle_unsigned

# ------------------------------------------------------------------------------
# Master Admin Credentials (for Admin Panel authentication)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=carcastlegoa@gmail.com

# ------------------------------------------------------------------------------
# SEO & Analytics Verification Keys
# ------------------------------------------------------------------------------
GOOGLE_SEARCH_CONSOLE_CODE=[YOUR_GOOGLE_SEARCH_CONSOLE_VERIFICATION_CODE]
BING_VERIFICATION_CODE=[YOUR_GOOGLE_SEARCH_CONSOLE_VERIFICATION_CODE]
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
