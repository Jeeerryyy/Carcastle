{
  "name": "carcastlegoa",
  "version": "1.0.0",
  "description": "Car Castle Goa - Premium Self-Drive Car Rentals in Goa",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build.js",
    "build:pages": "node scripts/compile-templates.js",
    "build:assets": "node scripts/minify-assets.js",
    "build:sitemap": "node scripts/generate-sitemap.js",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "node tests/e2e/admin-crud.test.js",
    "validate": "node scripts/validate_site.js",
    "optimize:images": "node scripts/optimize-images.js",
    "seo:keys": "node scripts/apply-seo-keys.js"
  },
  "keywords": [
    "car-rental",
    "goa",
    "self-drive",
    "carcastle"
  ],
  "author": "Car Castle Goa",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
